{
  "name": "translation-realtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "public": "npm run build && concurrently -k -n APP,TUNNEL -c cyan,magenta \"npm start\" \"cloudflared tunnel --config cloudflared.yml --no-autoupdate run\"",
    "check": "tsc -b --pretty false",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.13",
    "multer": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
