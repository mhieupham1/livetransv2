# LLM dịch / biên bản (OpenAI-compatible)
LLM_BASE_URL=https://ai.mhieupham.io.vn
LLM_API_KEY=replace-with-llm-key
LLM_MODEL=glm-5.3-flash

# STT realtime (có thể khác host/key với LLM)
TRANSCRIPTION_BASE_URL=http://localhost:3000
TRANSCRIPTION_API_KEY=replace-with-stt-key
TRANSCRIPTION_MODEL=soniox-stt

# Google Sign-In
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-long-random-string
PUBLIC_BASE_URL=https://translate.mhieupham.io.vn
# Hạn mức mặc định của gói Free/Pro (giây), chỉ dùng khi tạo bảng plans lần đầu.
# Sau đó sửa giá và hạn mức tại /admin/plans — không cần restart.
FREE_QUOTA_SECONDS=1800
PRO_QUOTA_SECONDS=2592000

# VietQR chuyển khoản nâng cấp
# Có thể bỏ trống các biến này và cấu hình tại /admin/settings (lưu trong DB,
# đổi không cần restart). Giá trị .env chỉ dùng làm mặc định ban đầu.
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
UPGRADE_AMOUNT_VND=99000
SEPAY_WEBHOOK_API_KEY=

# Tài khoản trang /admin được seed vào DB bằng: npm run seed
# (không dùng chung tài khoản Google của người dùng)

# Cổng backend; frontend dev server tự proxy /api tới cổng này
PORT=3001

# Địa chỉ lắng nghe. Mặc định 127.0.0.1 vì cloudflared chạy cùng máy và proxy tới localhost.
# Chỉ đổi thành 0.0.0.0 khi cần truy cập trực tiếp trong LAN — khi đó server sẽ KHÔNG tin
# header CF-Connecting-IP (tránh bị giả mạo để vượt giới hạn đăng nhập admin).
HOST=127.0.0.1

# Quy đổi ký tự dịch/biên bản sang giây hạn mức (mặc định 100 ký tự = 1 giây)
TRANSLATE_CHARS_PER_SECOND=100
